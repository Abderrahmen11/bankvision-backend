APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# Banking thresholds and estimate ratios
BANKING_HIGH_VALUE_THRESHOLD=10000
BANKING_EST_FEE_INCOME_RATE=0.005
BANKING_EST_OPERATING_COST_RATIO=0.35
BANKING_EST_CREDIT_PROVISION_RATE=0.10
BANKING_EST_CORPORATE_TAX_RATE=0.21
BANKING_EST_CASH_RESERVE_RATIO=0.10
BANKING_EST_OTHER_ASSETS_RATIO=0.05
BANKING_EST_CUSTOMER_DEPOSITS_RATIO=0.85
BANKING_EST_OTHER_LIABILITIES_RATIO=0.05
BANKING_EST_EQUITY_RATIO=0.08
BANKING_EST_DEPOSIT_INTEREST_SHARE=0.60
BANKING_EST_OPERATING_CASH_SHARE=0.02
BANKING_EST_LOAN_REPAYMENT_SHARE=0.05

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
